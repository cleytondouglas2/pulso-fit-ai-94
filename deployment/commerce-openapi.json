{
  "openapi": "3.1.0",
  "info": {
    "title": "ARGUS Pay Commerce Suite — API de desenvolvimento",
    "version": "0.2.0",
    "description": "Superfície de marketing e sandbox local. Estes endpoints não criam Pix válido, não creditam carteiras e não autorizam saques. A documentação financeira oficial do gateway continua separada."
  },
  "servers": [
    {
      "url": "https://arguspay.com.br"
    }
  ],
  "paths": {
    "/api/portal/commerce/pages": {
      "get": {
        "summary": "Listar minhas páginas comerciais",
        "description": "Exige sessão de revendedor autenticada",
        "responses": {
          "200": {
            "description": "Páginas da própria conta, sem dados de outras carteiras"
          }
        }
      },
      "post": {
        "summary": "Criar rascunho comercial",
        "description": "Sessão de revendedor e X-CSRF-Token. NÃO cria cobrança. Valor é apenas sugestão e pode ser omitido para permitir valor livre no Pix.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "description",
                  "call_to_action"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 600
                  },
                  "suggested_amount_cents": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Opcional. Use null ou omita para valor livre. Caso informado, 100 a 9000 centavos.",
                    "minimum": 100,
                    "maximum": 9000
                  },
                  "call_to_action": {
                    "type": "string",
                    "maxLength": 70
                  },
                  "image_url": {
                    "type": "string"
                  },
                  "accent_color": {
                    "type": "string"
                  },
                  "expires_at": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Página salva em rascunho"
          },
          "403": {
            "description": "Sessão ou CSRF inválidos"
          }
        }
      }
    },
    "/api/portal/commerce/sandbox": {
      "post": {
        "summary": "Simular estados de operação (offline, sem PSP)",
        "description": "Exige sessão autenticada e X-CSRF-Token. Gera status simulated_paid, simulated_pending, simulated_failed ou simulated_refunded. Não fornece cópia e cola Pix, ID da adquirente, webhook nem saldo.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "scenario",
                  "amount_cents"
                ],
                "properties": {
                  "scenario": {
                    "type": "string",
                    "enum": [
                      "paid",
                      "pending",
                      "failed",
                      "refunded"
                    ]
                  },
                  "amount_cents": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 1000000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resposta sintética não financeira"
          }
        }
      }
    },
    "/api/public/commerce/{code}": {
      "get": {
        "summary": "Consultar página comercial publicada",
        "description": "Somente informações públicas. A disponibilidade do Pix é confirmada pelo fluxo financeiro existente.",
        "parameters": [
          {
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Oferta e estado de disponibilidade do checkout"
          },
          "404": {
            "description": "Oferta não publicada, arquivada, expirada ou indisponível"
          }
        }
      }
    },
    "/api/portal/commerce/pages/{id}/publish": {
      "post": {
        "summary": "Publicar página comercial (independente de autorização Pix)",
        "description": "Exige sessão e X-CSRF-Token; ação não movimenta Pix, carteira ou saldo.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^cmp_[a-f0-9]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ação aplicada à página do próprio revendedor"
          },
          "404": {
            "description": "Página inexistente ou de outra conta"
          }
        }
      }
    },
    "/api/portal/commerce/pages/{id}/archive": {
      "post": {
        "summary": "Arquivar página e desativar link",
        "description": "Exige sessão e X-CSRF-Token; ação não movimenta Pix, carteira ou saldo.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^cmp_[a-f0-9]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ação aplicada à página do próprio revendedor"
          },
          "404": {
            "description": "Página inexistente ou de outra conta"
          }
        }
      }
    },
    "/api/portal/commerce/pages/{id}/delete": {
      "post": {
        "summary": "Excluir da listagem e invalidar link (retenção técnica para auditoria)",
        "description": "Exige sessão e X-CSRF-Token; ação não movimenta Pix, carteira ou saldo.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^cmp_[a-f0-9]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ação aplicada à página do próprio revendedor"
          },
          "404": {
            "description": "Página inexistente ou de outra conta"
          }
        }
      }
    },
    "/api/portal/commerce/logo": {
      "get": {
        "summary": "Consultar identidade visual comercial do revendedor",
        "description": "Sessão autenticada. Retorna disponibilidade, URL relativa de prévia e última atualização, nunca bytes da imagem.",
        "responses": {
          "200": {
            "description": "Identidade visual da conta"
          }
        }
      },
      "post": {
        "summary": "Enviar ou substituir logomarca (PNG/JPEG/WEBP, máximo 512 KiB)",
        "description": "Sessão autenticada e X-CSRF-Token. Apenas lojas comerciais: não modifica comprovantes, Pix ou adquirente.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "image_data_url"
                ],
                "properties": {
                  "image_data_url": {
                    "type": "string",
                    "description": "Imagem data URI: data:image/png;base64,... ou JPEG/WEBP; até 512 KiB decodificados"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Marca salva e aplicada às páginas comerciais"
          },
          "422": {
            "description": "Imagem excede o limite ou tem formato inválido"
          }
        }
      }
    },
    "/api/portal/commerce/logo/remove": {
      "post": {
        "summary": "Remover logo comercial do revendedor",
        "description": "Restaura o logo Argus Pay nas páginas comerciais, sem afetar dinheiro.",
        "responses": {
          "200": {
            "description": "Logo removida"
          }
        }
      }
    },
    "/api/portal/commerce/logo/image": {
      "get": {
        "summary": "Imagem da marca da conta autenticada",
        "responses": {
          "200": {
            "description": "PNG, JPEG ou WEBP do revendedor"
          }
        }
      }
    },
    "/api/public/commerce/logo/{code}": {
      "get": {
        "summary": "Logo em página comercial publicada",
        "description": "Somente retorna a marca se a oferta estiver publicada, dentro da validade, com vendedor não bloqueado.",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PNG, JPEG ou WEBP"
          },
          "404": {
            "description": "Oferta não publicada, expirada, excluída ou sem logo"
          }
        }
      }
    }
  }
}
